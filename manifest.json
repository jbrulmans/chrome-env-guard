{
  "manifest_version": 3,
  "name": "Env Guard",
  "version": "1.0.0",
  "description": "Paints an unmissable colour frame on the page when you are on production (or staging, or local), so you never mistake it for a safe environment.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["match.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Env Guard",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
